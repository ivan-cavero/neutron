# =============================================================================
# Neutron .gitignore
# Goal: never commit build artifacts, Minecraft servers/worlds, or vanilla jars.
# Source code + datapack JSON under crates/ + tools scripts/decompiled = commit.
# =============================================================================

# ----- Rust / Cargo build -----
/target/
**/target/
**/*.rs.bk
Cargo.toml.orig

# Cargo credentials (never commit)
.cargo/config.toml
.cargo/credentials
.cargo/credentials.toml

# ----- Bench harness (tests/benchmarks/, own workspace) -----
tests/benchmarks/target/
tests/benchmarks/Cargo.lock
tests/benchmarks/test-vanilla/
tests/benchmarks/test-paper/
tests/benchmarks/test-folia/
tests/benchmarks/test-pumpkin/
tests/benchmarks/test-server/
tests/benchmarks/logs/
tests/benchmarks/results/**
!tests/benchmarks/results/.gitkeep
# Keep human-written parity notes if needed:
!tests/benchmarks/results/parity-report-*.md
!tests/benchmarks/results/simulation-parity-check.md
tests/benchmarks/servers/**/*.jar
tests/benchmarks/servers/**/*.exe
tests/benchmarks/servers/**/*.zip
tests/benchmarks/servers/pumpkin/pumpkin
tests/benchmarks/libraries/
tests/benchmarks/versions/
tests/benchmarks/eula.txt
tests/benchmarks/**/world/
tests/benchmarks/**/logs/

# ----- Minecraft server junk (any path) -----
**/world/
**/world_nether/
**/world_the_end/
**/logs/
**/crash-reports/
eula.txt
server.properties
bukkit.yml
spigot.yml
paper.yml
commands.yml
ops.json
banned-players.json
banned-ips.json
whitelist.json
usercache.json
session.lock
*.log
*.log.gz

# Root-level accidental server dirs
/world/
/config/
/plugins/
/libraries/
/versions/

# ----- tools/ bulky runtime data (re-extract with scripts) -----
# NBT reference vanilla server runtime
tools/nbt-ref/vanilla1/libraries/
tools/nbt-ref/vanilla1/versions/
tools/nbt-ref/vanilla1/logs/
tools/nbt-ref/vanilla1/world/
tools/nbt-ref/vanilla1/**/*.jar
tools/nbt-ref/vanilla1/*.log
tools/nbt-ref/vanilla1/pregen*.log
tools/nbt-ref/vanilla1/server.log
tools/nbt-ref/vanilla1/ops.json
tools/nbt-ref/vanilla1/banned-*.json
tools/nbt-ref/vanilla1/whitelist.json
tools/nbt-ref/vanilla1/usercache.json
tools/nbt-ref/vanilla1/eula.txt
tools/nbt-ref/vanilla1/server.properties

# Vanilla reference server runtimes (re-extract with pregen scripts)
tools/nbt-ref/vanilla-fresh-*/
tools/nbt-ref/vanilla-fresh2-*/
tools/nbt-ref/vanilla-det-*/

# Java probe runtime (compiled .class against vanilla jar)
tools/worldgen-probe/bin/
tools/worldgen-probe/**/*.class

# ----- Tests e2e artifacts -----
tests/**/target/
tests/e2e-server/target/

# ----- IDE / OS -----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db
desktop.ini
*.iml
*.localized

# ----- Env / secrets -----
.env
.env.*
!.env.example

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# ----- Fuzz / profile -----
fuzz/artifacts/
fuzz/corpus/
**/fuzz/target/
*.prof
*.heaptrack
*.dhat
flamegraph.svg
perf.data

# ----- Archives (never bulk-upload) -----
*.tar.gz
*.zip
*.7z
*.rar
*.msi
*.dmg
*.deb
*.rpm

# ----- Temp / agent noise -----
tmp/
temp/
*.bak
*.old
*.orig
tmp_*
tmp-*
*.tmp
nul
logs/

# Agent / editor local state
.zcode/
.grok/
.cursor/
.claude/

# Windows reserved / accidental
/nul
*.stackdump
tools/mc-decompiler/output/
tools/mc-decompiler/target/
tools/mc-decompiler/jars/
tools/mc-decompiler/Cargo.lock

# probe session artifacts
java*.txt
rust*.txt
ruflat*.txt
tree*_dump.txt
treedbg.txt
leaf_inserts.txt
pret_*.err
paleflow_*.txt
tmp-flat.txt
tmp-terrain-*.txt
ruflat_mark.txt
rust_raw.txt
ruskip*.txt
truth_df.txt
javadf.txt
javaset_df.txt
bp_12345.txt
