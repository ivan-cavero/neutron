# =============================================================================
# Neutron .gitignore
# Goal: never commit build artifacts, Minecraft servers/worlds, or vanilla jars.
# Source code + datapack JSON under crates/ + tools scripts/decompiled = commit.
# =============================================================================

# ----- Rust / Cargo build -----
/target/
**/target/
**/*.rs.bk
Cargo.toml.orig

# Cargo credentials (never commit)
.cargo/config.toml
.cargo/credentials
.cargo/credentials.toml

# ----- Bench harness -----
bench/target/
bench/Cargo.lock
bench/test-vanilla/
bench/test-paper/
bench/test-folia/
bench/test-pumpkin/
bench/test-server/
bench/logs/
bench/results/**
!bench/results/.gitkeep
# Keep human-written parity notes if needed:
!bench/results/parity-report-*.md
!bench/results/simulation-parity-check.md
bench/servers/**/*.jar
bench/servers/**/*.exe
bench/servers/**/*.zip
bench/servers/pumpkin/pumpkin
bench/libraries/
bench/versions/
bench/eula.txt
bench/**/world/
bench/**/logs/

# ----- Minecraft server junk (any path) -----
**/world/
**/world_nether/
**/world_the_end/
**/logs/
**/crash-reports/
eula.txt
server.properties
bukkit.yml
spigot.yml
paper.yml
commands.yml
ops.json
banned-players.json
banned-ips.json
whitelist.json
usercache.json
session.lock
*.log
*.log.gz

# Root-level accidental server dirs
/world/
/config/
/plugins/
/libraries/
/versions/

# ----- tools/ bulky runtime data (re-extract with scripts) -----
# Vanilla server unpack + jars (GB-scale)
tools/vanilla-extract/server-classes/
tools/vanilla-extract/META-INF/
tools/vanilla-extract/net/
tools/vanilla-extract/lib/
tools/vanilla-extract/javap/
tools/vanilla-extract/**/*.jar
tools/vanilla-extract/EXTRACT-STAMP.txt
# Decompiled Java sources — reference parity data, not runtime
tools/vanilla-extract/decompiled/**/*.jar

# NBT reference vanilla server runtime
tools/nbt-ref/vanilla1/libraries/
tools/nbt-ref/vanilla1/versions/
tools/nbt-ref/vanilla1/logs/
tools/nbt-ref/vanilla1/world/
tools/nbt-ref/vanilla1/**/*.jar
tools/nbt-ref/vanilla1/*.log
tools/nbt-ref/vanilla1/pregen*.log
tools/nbt-ref/vanilla1/server.log
tools/nbt-ref/vanilla1/ops.json
tools/nbt-ref/vanilla1/banned-*.json
tools/nbt-ref/vanilla1/whitelist.json
tools/nbt-ref/vanilla1/usercache.json
tools/nbt-ref/vanilla1/eula.txt
tools/nbt-ref/vanilla1/server.properties
tools/nbt-ref/find-real/target/
tools/nbt-ref/**/target/

# Java probe runtime
tools/java-probe/bin/
tools/java-probe/libs/
tools/java-probe/**/*.class
tools/java-probe/**/*.jar

# ----- Tests e2e artifacts -----
tests/**/target/
tests/e2e-server/target/

# ----- IDE / OS -----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db
desktop.ini
*.iml
*.localized

# ----- Env / secrets -----
.env
.env.*
!.env.example

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# ----- Fuzz / profile -----
fuzz/artifacts/
fuzz/corpus/
**/fuzz/target/
*.prof
*.heaptrack
*.dhat
flamegraph.svg
perf.data

# ----- Archives (never bulk-upload) -----
*.tar.gz
*.zip
*.7z
*.rar
*.msi
*.dmg
*.deb
*.rpm

# ----- Temp / agent noise -----
tmp/
temp/
*.bak
*.old
*.orig
tmp_*
nul
logs/

# Agent / editor local state
.zcode/
.grok/
.cursor/
.claude/

# Windows reserved / accidental
/nul
*.stackdump
